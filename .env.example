# Access to /api from any other device (a phone on the network, Docker, a server). Unset: only this computer
# is served. The web app asks for the token once and keeps it in that browser. Behind a reverse proxy, set it.
# S2C_ACCESS_TOKEN=pick-a-long-random-string
# Every variable below is checked when the server starts (s2c/config.py): a bad value stops it with its name.
# ALLOWED_ORIGINS=https://my-app.example  # extra web origins allowed by CORS, comma-separated
# S2C_MAX_PIXELS=40000000  # largest image accepted; OPENCV_IO_MAX_IMAGE_PIXELS is set from it, leave that unset
# S2C_DATA_DIR=/var/lib/s2c  # working files (built parts in tmp/, logs/); default: the project folder
# S2C_LOG_DIR=logs  # call logs; default: <S2C_DATA_DIR>/logs
# S2C_LOG_FORMAT=json  # json (default) or text
# S2C_LOG_LEVEL=INFO  # DEBUG adds the traceback to every fallback line

# Vision model provider. One OpenAI-compatible client, selected by these three variables.
# Active: Ollama (local, no key needed)
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=ollama

# Qwen-VL on DashScope (OpenAI-compatible): face labels and handwriting
# VLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=replace-with-a-current-qwen-vl-model
# VLM_API_KEY=replace-me

# NVIDIA Build (event day, 27 September 2026)
# VLM_BASE_URL=https://integrate.api.nvidia.com/v1
# VLM_MODEL=
# VLM_API_KEY=

# Google Gemini free tier
# VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VLM_MODEL=
# VLM_API_KEY=

# Groq free tier
# VLM_BASE_URL=https://api.groq.com/openai/v1
# VLM_MODEL=
# VLM_API_KEY=

# Describe chat model (POST /api/chat). Each falls back to the VLM_* value when unset.
# Groq free tier preset (set all three together):
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-120b
# CHAT_API_KEY=

# Qwen-Image: "space" (default) or "dashscope"
QWEN_IMAGE_BACKEND=space
QWEN_IMAGE_SPACE=Qwen/Qwen-Image-2.1
# QWEN_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# QWEN_IMAGE_MODEL=replace-with-a-qwen-image-edit-model

# Solaria depth (Marigold V2) and TripoSR on Hugging Face Spaces
SOLARIA_SPACE=CronosSa/Solaria1.0
TRIPOSR_SPACE=stabilityai/TripoSR
# HF_TOKEN=hf_...  # raises the ZeroGPU quota
# TRIPOSR_DIR=vendor/TripoSR  # local TripoSR checkout (scripts/setup_triposr.ps1)

# Slicer and test settings
# SLICER_PATH=C:/Program Files/Prusa3D/PrusaSlicer/prusa-slicer-console.exe
# SLICER_PROFILE=profiles/fdm_default.ini
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.2/blender.exe  # rendered preview
# Or a Python with Blender's bpy module, instead of BLENDER_PATH:
# BLENDER_PYTHON=
# NETWORK_TESTS=1  # runs tests/test_mv_network.py against the hosted models

# Handwriting reading (s2c/reading): Qwen-VL time budget, local TrOCR model, per-call log
# READ_TIMEOUT_S=20
# TROCR_MODEL=microsoft/trocr-base-handwritten
# READING_LOG=logs/reading.jsonl
# TROCR_BATCH=8  # crops per TrOCR batch
# GPU_BUDGET_TROCR_GB=1.0  # TrOCR's share of the GPU; an out-of-memory load or read falls back to CPU instead

# Hand-sketch path (s2c/sketch): readers in order, PaddleOCR models, text detector, debug images
# SKETCH_READERS=trocr,paddle,vlm
# SKETCH_PADDLE_MODEL=PP-OCRv5_server_rec
# SKETCH_PADDLE_DET=PP-OCRv5_server_det
# SKETCH_TEXT_DETECTOR=auto  # auto, paddle or classical
# SKETCH_DEBUG_DIR=tmp/sketch_debug

# OLLAMA_KEEP_ALIVE=30m  # read by the Ollama server, not this app: keeps qwen loaded past its 5 min idle default
# OLLAMA_GPU_OVERHEAD=1073741824  # read by the Ollama server: bytes it keeps free so it fits alongside TrOCR
