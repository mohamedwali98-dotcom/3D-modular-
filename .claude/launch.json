{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "app_mv_studio.py"
      ],
      "port": 7860
    },
    {
      "name": "mv-gradio",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "app_mv_gradio.py"
      ],
      "port": 7860
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "s2c.web.server:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
